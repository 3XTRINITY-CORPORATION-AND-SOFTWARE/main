{
  "include": [
    "src/**",
    "scripts/**"
  ],
  "exclude": [
    "node_modules/**",
    "coverage/**",
    "dist/**",
    ".vercel/**",
    ".output/**",
    ".nitro/**",
    ".vinxi/**",
    ".turbo/**",
    "**/*.test.*",
    "**/*.test.mjs",
