#!/bin/bash
REPO="$1"

CS=$(gh codespace create --repo "$REPO" --quiet)
gh codespace exec -c "$CS" -- bash -lc "npm install || pnpm install || yarn install"
gh codespace exec -c "$CS" -- bash -lc "npm test || pnpm test || yarn test"

// core-orchestrator.ts
import { spawn } from "child_process";

const repos = [
  "3XTRINITY-CORPORATION-AND-SOFTWARE/STEEL-3XTRINITY-CORPORATION-OFFICIAL-APP-",
  // lisa siia kõik ülejäänud reposid
];

const agents = [
  "agents/github-agent.sh",
  "agents/codespace-agent.sh",
  "agents/analysis-agent.sh",
  "agents/selfrepair-agent.sh",
  "agents/security-agent.sh",
  "agents/merge-agent.sh",
  "agents/branch-agent.sh",
  "agents/devcontainer-agent.sh",
  "agents/dependency-agent.sh",
  "agents/structure-agent.sh",
  "agents/lint-agent.sh",
  "agents/test-agent.sh",
  "agents/ci-agent.sh",
  "agents/log-agent.sh",
  "agents/rollback-agent.sh",
  // kuni 50+ agenti
];

async function cycle() {
  for (const repo of repos) {
    for (const agent of agents) {
      spawn("bash", [agent, repo], { stdio: "inherit" });
    }
  }
}

setInterval(cycle, 3 * 60 * 1000); // iga 3 minuti tagant
